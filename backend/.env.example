APP_NAME="AI Game Hero Designer Backend"
APP_VERSION="0.1.0"
ENV="development"
CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173"

# LLM_PROVIDER 可选：fake / openai / openai_compatible
LLM_PROVIDER=openai

LLM_API_KEY=
LLM_BASE_URL=
LLM_TEXT_MODEL=

LLM_REQUEST_TIMEOUT=60
LLM_MAX_RETRIES=2

# IMAGE_PROVIDER 可选：fake / openai / openai_compatible
IMAGE_PROVIDER=fake

IMAGE_API_KEY=
IMAGE_BASE_URL=
IMAGE_MODEL=

IMAGE_REQUEST_TIMEOUT=180
IMAGE_MAX_RETRIES=3
IMAGE_DEFAULT_WIDTH=1024
IMAGE_DEFAULT_HEIGHT=1024
IMAGE_OUTPUT_FORMAT=png

# OpenAI-compatible image provider example:
# IMAGE_PROVIDER=openai_compatible
# IMAGE_API_KEY=your-compatible-image-api-key
# IMAGE_BASE_URL=https://your-provider.example/v1
# IMAGE_MODEL=gpt-image-2
